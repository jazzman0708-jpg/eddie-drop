#!/bin/bash
#
# 설치 직후 정리 — 이 스크립트가 안 돌면 패널이 안 뜬다.
#
# macOS 는 모든 파일에 com.apple.provenance 라는 속성을 자동으로 붙이는데,
# 이건 지울 수가 없다. 그래서 pkgbuild 가 파일마다 "._이름" 짝꿍 파일을
# 같이 만들어 넣는다.
#
# CEP 는 서명할 때 없던 파일이 확장 폴더에 있으면 서명이 깨진 것으로 보고
# 확장을 아예 불러오지 않는다. (윈도우에서 uninstall.exe 때문에 겪은 것과 같은 문제)
# → 여기서 반드시 지워야 한다.
#
# 설정 폴더(~/Library/Application Support/Eddie)는 절대 건드리지 않는다.
#
set -u

# 설치 대상 사용자의 홈 폴더 (preinstall 과 같은 방식)
TARGET_HOME="$HOME"
if [ -n "${USER:-}" ] && [ -d "/Users/$USER" ]; then TARGET_HOME="/Users/$USER"; fi

EXTENSIONS="$TARGET_HOME/Library/Application Support/Adobe/CEP/extensions"
EXT="$EXTENSIONS/com.eddie.drop"

# 1) 확장 폴더 안의 군더더기
if [ -d "$EXT" ]; then
  find "$EXT" -name '._*' -delete 2>/dev/null
  find "$EXT" -name '.DS_Store' -delete 2>/dev/null
fi

# 2) 확장 폴더 옆에 생기는 짝꿍 파일 (extensions/._com.eddie.drop)
rm -f "$EXTENSIONS/._com.eddie.drop" 2>/dev/null

# 3) 정말 깨끗해졌는지 확인하고, 안 됐으면 설치를 실패로 알린다.
#    조용히 넘어가면 "설치는 됐는데 패널이 안 뜬다" 가 되어 원인을 찾기 어렵다.
if [ -d "$EXT" ]; then
  LEFT="$(find "$EXT" -name '._*' 2>/dev/null | wc -l | tr -d ' ')"
  if [ "$LEFT" != "0" ]; then
    echo "정리하지 못한 파일이 ${LEFT}개 남았습니다. 패널이 뜨지 않을 수 있습니다." >&2
    exit 1
  fi
fi

exit 0
